# Copy this file to .env and fill in real values.
# The production workflow creates .env from GitHub Secrets.

ENVIRONMENT=development

DB_HOST=localhost
DB_NAME=thecodingscience
DB_USER=root
DB_PASS=

SITE_URL=http://localhost:8000
SITE_NAME=The Coding Science

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strong random value; required in production
SECRET_KEY=change-me
